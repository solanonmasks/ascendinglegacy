---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../site';
---
<Base
  title="Get a Quote"
  description="Request a life, health or travel insurance quote from Ascending Legacy. Tell us who needs coverage and we will call you back the same business day."
  hideMobileBar
>
  <section class="split" style="min-height:calc(100vh - var(--header-h));">
    <div class="navy split__text" style="padding:clamp(64px,8vw,128px) clamp(24px,5vw,96px);gap:40px;justify-content:space-between;">
      <div class="stack" style="--gap:28px;">
        <span class="rule"></span>
        <h1 class="h1-sm">Tell us who needs coverage. <span class="accent">We will call you back the same business day.</span></h1>
      </div>
      <div class="stack" style="--gap:10px;">
        <div class="on-navy">Prefer to talk now?</div>
        <a href={site.phoneHref} class="serif" style="font-size:clamp(34px,3vw,44px);line-height:1.1;color:var(--gold);text-decoration:none;">{site.phone}</a>
        <p class="small-print" style="margin-top:12px;max-width:460px;">{site.licence} Premiums depend on age, health and the coverage chosen.</p>
      </div>
    </div>
    <div style="padding:clamp(48px,6vw,104px) clamp(24px,5vw,96px);display:flex;align-items:center;">
      <QuoteForm />
    </div>
  </section>
</Base>
