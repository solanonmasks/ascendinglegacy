---
import Base from '../../layouts/Base.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { site, photos } from '../../site';

const children = [
  { title: 'Super Visa Insurance', href: '/travel-insurance/super-visa-insurance/', body: 'The $100,000 emergency medical coverage IRCC requires, from a Canadian insurer, with the letter for your application.' },
  { title: 'Visitors to Canada', href: '/travel-insurance/visitors-to-canada/', body: 'Emergency medical for relatives, new immigrants waiting for MSP, students and temporary workers.' },
  { title: 'Snowbird Coverage', href: '/travel-insurance/snowbird-coverage/', body: 'Multi-month emergency medical for BC residents wintering outside the province, with pre-existing condition questions answered honestly.' },
  { title: 'Trip and Vacation Coverage', href: '/travel-insurance/trip-and-vacation-coverage/', body: 'Emergency medical and trip cancellation for shorter trips.' },
];
---
<Base
  title="Travel Insurance Vancouver: Super Visa, Visitors and Snowbird"
  description="Travel insurance from a Metro Vancouver advisor: Super Visa insurance, visitors to Canada, snowbird and trip coverage. Quotes across carriers and the proof-of-coverage letter you need."
>
  <section class="hero" style={`min-height:calc(80vh - var(--header-h));align-items:flex-end;background-image:linear-gradient(90deg,rgba(12,21,34,.94) 0%,rgba(12,21,34,.72) 45%,rgba(12,21,34,.2) 85%),url('${photos.vancouver}');background-position:center;`}>
    <div class="container" style="width:100%;padding-top:clamp(72px,9vw,130px);padding-bottom:clamp(72px,9vw,130px);">
      <div class="stack" style="max-width:820px;--gap:28px;">
        <div class="eyebrow">Travel insurance</div>
        <h1 style="font-size:clamp(44px,5.8vw,86px);">Travel insurance that meets the requirement and <em>pays the claim.</em></h1>
      </div>
    </div>
  </section>

  <section class="container section--md grid" style="--min:420px;--gap:clamp(48px,7vw,120px);align-items:start;">
    <p data-fade class="big-serif">Whether your parents are coming for the summer, you are heading south for the winter, or a family member is waiting for MSP, the coverage has to be right the first time.</p>
    <div data-fade class="stack" style="--gap:28px;">
      <p class="muted">We quote across our carriers, explain the stability clauses that decide whether a claim gets paid, and send you the proof-of-coverage letter you need.</p>
      <a href="#travel-quote" class="btn btn--primary" style="align-self:flex-start;">Get a travel quote</a>
    </div>
  </section>

  <section class="navy split">
    <div class="photo" style={`min-height:clamp(420px,50vw,820px);background-image:url('${photos.lake}');`}></div>
    <div class="split__text link-list" style="padding:clamp(64px,8vw,120px) clamp(24px,6vw,96px);">
      {children.map((c) => (
        <a href={c.href} data-fade>
          <span class="link-list__title">{c.title} →</span>
          <p>{c.body}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="travel-quote" class="container section grid" style="--min:380px;--gap:clamp(48px,7vw,120px);align-items:start;scroll-margin-top:var(--header-h);">
    <div data-fade class="stack">
      <span class="rule"></span>
      <h2>Get a travel quote.</h2>
      <p class="muted max-480">Tell us who is travelling and when. We will quote across our carriers and call you back the same business day.</p>
      <p class="muted max-480">Prefer to talk now? <a href={site.phoneHref} style="font-weight:600;">{site.phone}</a></p>
      <p class="muted" style="font-size:16px;">{site.licence} Premiums depend on age, health and the coverage chosen.</p>
    </div>
    <QuoteForm id="travel-quote-form" />
  </section>
</Base>
