// DRAFT — a starting point only. Have this reviewed (BC PIPA / federal PIPEDA) before launch.
import LegalPage from '../components/LegalPage.astro';
import { site } from '../site';
---
<LegalPage title="Privacy Policy" description="How Ascending Legacy Inc. collects, uses and protects your personal information." updated="October 2026">
  <p>{site.name} ("we", "us") respects your privacy. This policy explains what personal information we collect through this website and how we use it.</p>

  <h2>What we collect</h2>
  <p>When you fill in a form, we collect the details you give us, such as your name, phone number, email, the type of coverage you are interested in, ages, travel dates and any notes. We also record how you found us (for example, the advertising campaign or web page) so we can understand which channels work.</p>
  <p>Like most websites, we may use analytics and advertising cookies to measure visits and the performance of our ads. You can block cookies in your browser settings.</p>

  <h2>How we use it</h2>
  <ul>
    <li>To contact you about your request and prepare quotes.</li>
    <li>To submit applications to insurers, only with your consent.</li>
    <li>To meet our legal and regulatory obligations as licensed insurance advisors.</li>
  </ul>
  <p>We do not sell your personal information.</p>

  <h2>Who we share it with</h2>
  <p>We share information only as needed to serve you: with insurance carriers and our managing general agency when you apply, and with service providers that host our website and forms, under appropriate safeguards.</p>

  <h2>Your choices</h2>
  <p>You can ask to see, correct or delete the personal information we hold about you, subject to legal requirements. Contact us at <a href={`mailto:${site.email}`}>{site.email}</a> or {site.phone}.</p>

  <h2>Contact</h2>
  <p>{site.name}, {site.address.street}, {site.address.city}, {site.address.region}.</p>
</LegalPage>
