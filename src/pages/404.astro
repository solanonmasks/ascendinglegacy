---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="navy" style="min-height:calc(80vh - var(--header-h));display:flex;align-items:center;">
    <div class="container section stack" style="--gap:28px;">
      <span class="rule"></span>
      <h1>We could not find <em>that page.</em></h1>
      <p class="on-navy lead max-600">It may have moved. Try the home page, or get in touch and we will help.</p>
      <div class="btn-row">
        <a href="/" class="btn btn--primary">Go to the home page</a>
        <a href="/contact/" class="btn btn--secondary">Contact us</a>
      </div>
    </div>
  </section>
</Base>
